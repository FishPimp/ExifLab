    <!-- Privacy -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_subtitle">How ExifLab treats your photos</string>
    <string name="privacy_offline_title">Offline by design</string>
    <string name="privacy_offline_body">ExifLab reads and edits your photos on this device. Photos and their metadata are never uploaded anywhere.</string>
    <string name="privacy_tracking_title">No ads, analytics or tracking</string>
    <string name="privacy_tracking_body">There are no ads, no analytics, no crash reporting and no accounts. ExifLab collects nothing about you or how you use it.</string>
    <string name="privacy_network_title">What uses the internet</string>
    <string name="privacy_network_body">Only two features go online, and only while you use them: map tiles from OpenFreeMap (OpenStreetMap data) when a map is shown, and place search from Photon (Komoot) when you search for a place. These requests contain a map area or your search text, never your photos. Offline mode turns both off.</string>
    <string name="privacy_files_title">Only the files you choose</string>
    <string name="privacy_files_body">ExifLab can only open photos you pick, photos shared to it, and folders you grant access to. You can remove folder access at any time.</string>
    <string name="privacy_backups_title">Backups stay on your device</string>
    <string name="privacy_backups_body">Before a photo is changed, the original is copied to ExifLab\'s private storage so you can restore it. Backups are deleted after 30 days, or when you uninstall the app.</string>
    <string name="privacy_permissions_title">Permissions</string>
    <string name="privacy_permissions_body">Photos and folders are opened through the system photo picker and folder access. Notifications show the progress of batch edits. Internet access is used for maps and place search only.</string>

