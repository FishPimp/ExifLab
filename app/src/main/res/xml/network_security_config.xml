<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, trusting the system's certificate authorities. The app's HTTP client also refuses
     plain HTTP and any host besides tiles.openfreemap.org and photon.komoot.io. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
