<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Map tiles and place search only, through the app's allowlisted HTTP client. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the map show its offline drawing instead of failing when there is no connection. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Batch edits run as a foreground worker with a progress notification. The notification is
         optional: without the permission the job runs anyway and the app shows its progress. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- MapLibre declares these for its location component, which ExifLab does not use. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <!-- MapLibre renders with Vulkan. The map falls back to a drawing without it, so the rest of
         the app still installs and works on devices that lack it. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x400003"
        android:required="false"
        tools:replace="android:required" />

    <application
        android:name=".ExifLabApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExifLab"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ExifLab.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share target: photos shared from other apps open directly in the viewer. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- Launcher shortcut: "Share clean" picks photos and shares cleaned copies. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- "Clean and share": a second share target that cleans shared photos and shares them on,
             over the sending app (translucent), and the launcher shortcut's target. -->
        <activity
            android:name=".ui.shareclean.ShareCleanActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@mipmap/ic_share_clean"
            android:label="@string/share_clean_and_share"
            android:roundIcon="@mipmap/ic_share_clean"
            android:taskAffinity=""
            android:theme="@style/Theme.ExifLab.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Serves cleaned copies (cache/shared only) to the app they are shared with, by read grant. -->
        <provider
            android:name=".data.shareclean.ShareCleanFileProvider"
            android:authorities="${applicationId}.shareclean"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shareclean_paths" />
        </provider>

        <!-- WorkManager's foreground service, typed for batch edits writing files. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Cancel from the batch notification. Only this app's own PendingIntent reaches it. -->
        <receiver
            android:name=".data.batch.BatchCancelReceiver"
            android:exported="false" />

        <!-- Stores the per-app language on Android 12 and lower. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
